---
// All <head> meta. Pages pass title and description (plus image, type, jsonLd when needed) to Base.astro.
import type { ImageMetadata } from 'astro';
import { seo, site } from '../../config';
import { cardSize, shareCard } from '../../lib/content';

interface Props {
  title?: string; // site name only when omitted
  description?: string;
  // An imported photograph; it is re-encoded here into the share card. A string is taken as
  // a path to a card already sitting in public/.
  image?: string | ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[]; // per-page additions such as BlogPosting and BreadcrumbList
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  image = site.defaultOgImage,
  type = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? seo.titleTemplate.replace('%s', title) : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(typeof image === 'string' ? image : await shareCard(image), Astro.site);
const home = new URL('/', Astro.site).href;
const locale = Astro.currentLocale ?? site.locale;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    description: site.description,
    url: home,
    inLanguage: locale,
    publisher: { '@type': seo.jsonLd.type, name: seo.jsonLd.name, url: home },
  },
  ...jsonLd.map((d) => ({ '@context': 'https://schema.org', ...d })),
];
// prevent </script> injection
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(cardSize.width)} />
<meta property="og:image:height" content={String(cardSize.height)} />

<meta name="twitter:card" content="summary_large_image" />
{seo.twitterHandle && <meta name="twitter:site" content={seo.twitterHandle} />}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={schemaJson}></script>
