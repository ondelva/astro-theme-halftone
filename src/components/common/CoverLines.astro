---
// The signature: a column of teasers set on a cover plate, one label box, headline and deck
// each, divided by a rule and a + glyph. config.ts decides how many, what divides them, and
// whether the column sits on the photograph or beside it.
//
// coverLines.overlay = false is also the fallback for a photograph too light or too busy to
// carry type: the column drops onto its own plate-coloured panel below the picture.
import { coverLines } from '../../config';
import type { Item } from '../../lib/content';

interface Props {
  items: Item[];
  // A label that would only repeat the heading above the column -- a desk front sets its own
  // name here, so its cover lines print a box only where the piece carries its own rubric.
  omitKicker?: string;
  // One level under the PlateHead this column follows, so the outline never skips a rank.
  as?: 'h2' | 'h3';
  class?: string;
}
const { items, omitKicker, as: Heading = 'h2', class: className } = Astro.props;
---

{items.length > 0 && (
  <ol
    class:list={[
      'cover-lines',
      coverLines.overlay ? '' : 'bg-[var(--plate)] p-5 text-[var(--on-plate)] sm:p-6',
      className,
    ]}
    data-divider={coverLines.divider}
  >
    {items.map((item) => (
      <li class="py-5 first:pt-0 last:pb-0">
        {item.kicker !== omitKicker && <span class="kicker">{item.kicker}</span>}
        <Heading
          class:list={[
            'font-ui mb-2 text-[clamp(1.35rem,3.2vw,2.1rem)] leading-[0.98] font-extrabold tracking-[-0.02em] uppercase',
            item.kicker !== omitKicker && 'mt-3',
          ]}
        >
          <a class="no-underline hover:text-[var(--primary-on-plate)]" href={item.href}>
            {item.data.title}
          </a>
        </Heading>
        <p class="font-ui text-[0.8125rem] leading-relaxed" style="color: var(--on-plate-muted)">
          {item.data.deck}
        </p>
      </li>
    ))}
  </ol>
)}
