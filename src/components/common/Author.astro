---
// A contributor, set as portrait beside name, role and bio. Used at the foot of an article
// and down the colophon masthead, which is why the role is a prop: the masthead already
// groups by title and prints only the qualifier after it.
import { Image } from 'astro:assets';
import type { Author } from '../../lib/content';

interface Props {
  author: Author;
  // Passed, never defaulted: the masthead already prints the title in the column beside.
  role?: string;
  // Off down the colophon masthead, where Contact below is the page's one list of addresses.
  links?: boolean;
  // The contributor's own page, where the build has one. Nothing passes it in the free build
  // and the name stays plain text.
  href?: string;
}
const { author, role, links: showLinks = true, href } = Astro.props;
const { name, bio, portrait, links } = author.data;
---

<div class="flex gap-4">
  {portrait && (
    <Image
      class="size-14 shrink-0 object-cover sm:size-16"
      src={portrait}
      alt=""
      width={128}
      height={128}
      format="avif"
      loading="lazy"
    />
  )}
  <div class="min-w-0">
    <p class="font-ui text-sm font-bold">
      {href ? (
        <a class="hover:text-primary no-underline" href={href}>
          {name}
        </a>
      ) : (
        name
      )}
      {role && <span class="text-muted font-normal"> · {role}</span>}
    </p>
    {bio && <p class="mt-1 max-w-[56ch] text-sm leading-relaxed">{bio}</p>}
    {showLinks && links && links.length > 0 && (
      <ul class="text-muted mt-2 flex flex-wrap gap-x-4 font-mono text-[0.625rem] uppercase">
        {links.map((link) => (
          <li>
            <a class="hover:text-primary" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
