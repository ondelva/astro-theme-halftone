---
// The analytics tag, set in <head>. Nothing at all is emitted until a provider is named in
// config.ts, so a site that measures nothing ships no third-party script, no cookie banner
// and no extra request -- which is also why the default is none.
//
// Plausible and Umami need no consent notice in their hosted form: neither sets a cookie nor
// stores an identifier. GA4 does both, and a site using it needs its own notice. That is a
// legal choice, not a theme setting, so this file does not pretend to make it for you.
import { analytics } from '../../config';

const { provider, id, host } = analytics;
const origin = host.replace(/\/+$/, '');
const src = {
  plausible: `${origin || 'https://plausible.io'}/js/script.js`,
  umami: `${origin || 'https://cloud.umami.is'}/script.js`,
  ga4: `https://www.googletagmanager.com/gtag/js?id=${id}`,
}[provider ?? 'plausible'];
const on = Boolean(provider && id);
---

{on && provider === 'plausible' && <script is:inline defer data-domain={id} src={src}></script>}
{on && provider === 'umami' && <script is:inline defer data-website-id={id} src={src}></script>}
{on && provider === 'ga4' && (
  <Fragment>
    <script is:inline async src={src}></script>
    {/* gtag reads its queue off `arguments`, so this one cannot be an arrow function. */}
    <script
      is:inline
      set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(id)})`}
    ></script>
  </Fragment>
)}
