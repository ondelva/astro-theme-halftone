---
// The type laid on a cover plate: label box, headline, deck. The home cover, the photo essay
// strip, a desk front and a photo essay's own hero all set the same three things, so they set
// them here. Keep the column inside 32rem -- the .plate comment in global.css says why the
// scrim depends on it.
interface Props {
  // Absent where the label would only repeat what the page already says above it.
  kicker?: string;
  spot?: boolean; // the label box in the spot colour, for a standing rubric
  title: string;
  deck?: string;
  href?: string; // absent on an article's own hero: the headline is the page
  as?: 'h1' | 'h2';
  id?: string;
  class?: string;
}
const {
  kicker,
  spot = false,
  title,
  deck,
  href,
  as: Heading = 'h1',
  id,
  class: className,
} = Astro.props;
---

<div class:list={['max-w-[32rem]', className]}>
  {kicker && <span class:list={['kicker', spot && 'kicker--spot']}>{kicker}</span>}
  <Heading
    id={id}
    class:list={[
      'font-ui text-[clamp(1.75rem,4.6vw,3rem)] leading-[0.95] font-extrabold tracking-[-0.025em] uppercase',
      kicker && 'mt-3',
    ]}
  >
    {href ? (
      <a class="no-underline hover:text-[var(--primary-on-plate)]" href={href}>
        {title}
      </a>
    ) : (
      title
    )}
  </Heading>
  {deck && (
    <p
      class="font-ui mt-3 max-w-[26rem] text-[0.9375rem] leading-relaxed"
      style="color: var(--on-plate-muted)"
    >
      {deck}
    </p>
  )}
</div>
