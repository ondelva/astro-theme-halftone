---
// A cover plate: a photograph with type laid on it. The scrim and the type colours come from
// the .plate block in global.css; this component only handles the photograph -- the crop, the
// credit, and whether it loads eagerly. Whatever sits on the plate is passed as children, so
// the home cover, a desk front and a photo essay strip all use the same plate.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  credit?: string;
  // Keeps the cover lines off a face. Set per article in frontmatter.
  focus?: 'left' | 'center' | 'right';
  // The home cover is the largest thing above the fold; everything else waits.
  priority?: boolean;
  class?: string;
}
const { image, alt, credit, focus = 'center', priority = false, class: className } = Astro.props;
---

<div class:list={['plate', className]}>
  {/* The sample photographs ship as AVIF; re-encoding them to Astro's default WebP
      doubled the built payload (1.5MB against 804KB across the cover). */}
  <Image
    src={image}
    alt={alt}
    widths={[640, 960, 1400, 1800]}
    format="avif"
    sizes="100vw"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    style={`object-position: ${focus} center`}
  />
  <slot />
  {credit && (
    <p
      class="pointer-events-none absolute end-3 bottom-3 font-mono text-[0.625rem] tracking-tight"
      style="color: var(--on-plate-muted)"
    >
      {credit}
    </p>
  )}
</div>
