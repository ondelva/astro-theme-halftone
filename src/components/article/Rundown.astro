---
// A list of pieces set as a column of small pictures and headlines. Used at the foot of an
// article for the related reading and on a series page for its parts: in both places the
// reader is scanning headlines, not being sold cards, so the picture stays a thumbnail.
import { Image } from 'astro:assets';
import type { Item } from '../../lib/content';

interface Props {
  items: Item[];
  // On a series the running order is the point, so the folio opens with the part number.
  numbered?: boolean;
  // Off where the page is already one desk and the name would only repeat the heading.
  desk?: boolean;
  class?: string;
}
const { items, numbered = false, desk = true, class: className } = Astro.props;
---

<ol class={className}>
  {items.map((item, index) => (
    <li class="border-border grid grid-cols-[4.5rem_1fr] gap-4 border-b py-5 sm:grid-cols-[7rem_1fr]">
      <a class="block no-underline" href={item.href} tabindex="-1" aria-hidden="true">
        <Image
          class="aspect-[3/2] w-full object-cover"
          src={item.data.hero}
          alt=""
          widths={[224, 448]}
          format="avif"
          sizes="(min-width: 640px) 7rem, 4.5rem"
          loading="lazy"
          style={`object-position: ${item.data.heroFocus} center`}
        />
      </a>
      <div class="min-w-0">
        <a class="font-ui hover:text-primary leading-tight font-bold no-underline" href={item.href}>
          {item.data.title}
        </a>
        <p class="text-muted mt-1 font-mono text-[0.625rem] uppercase">
          {numbered && <span class="text-foreground">Part {index + 1} · </span>}
          {desk && `${item.desk.data.name} · `}
          {item.date}
        </p>
      </div>
    </li>
  ))}
</ol>
