---
// One card, used wherever an article is listed with its photograph. The format is pinned to
// AVIF for the reason Plate.astro gives.
//
// Used: the desk blocks on the home page, and the desk fronts. `layout` changes the
// arrangement, `size` the headline's weight in the hierarchy; the order is picture, label,
// headline, deck, folio, every time, because that is the order a reader scans them.
import { Image } from 'astro:assets';
import { blog } from '../../config';
import type { Item } from '../../lib/content';

interface Props {
  item: Item;
  // 'row' sets the picture beside the type instead of over it: a desk index reads down the
  // page, where the home page reads across it.
  layout?: 'stack' | 'row';
  size?: 'lead' | 'default';
  // Off where the label would only repeat the desk bar or the page heading above it.
  kicker?: boolean;
  deck?: boolean;
  priority?: boolean;
  class?: string;
}
const {
  item,
  layout = 'stack',
  size = 'default',
  kicker = true,
  deck = true,
  priority = false,
  class: className,
} = Astro.props;
const lead = size === 'lead';
const row = layout === 'row';
const widths = row ? [256, 512] : lead ? [640, 960, 1400] : [400, 640, 960];
const sizes = row
  ? '(min-width: 640px) 16rem, 7rem'
  : lead
    ? '(min-width: 1024px) 60rem, 100vw'
    : '(min-width: 640px) 22rem, 100vw';
---

<article
  class:list={[
    row && 'grid grid-cols-[7rem_1fr] gap-4 sm:grid-cols-[16rem_1fr] sm:gap-7',
    className,
  ]}
>
  <a class="block no-underline" href={item.href} tabindex="-1" aria-hidden="true">
    <Image
      class="aspect-[3/2] w-full object-cover"
      src={item.data.hero}
      alt=""
      widths={widths}
      format="avif"
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      style={`object-position: ${item.data.heroFocus} center`}
    />
  </a>
  <div class:list={[row ? 'min-w-0' : 'mt-3']}>
    {kicker && <span class="kicker">{item.kicker}</span>}
    <h3
      class:list={[
        'font-ui leading-tight tracking-tight',
        kicker && 'mt-2',
        lead ? 'text-[clamp(1.6rem,3.4vw,2.25rem)] font-extrabold' : 'text-xl font-bold',
      ]}
    >
      <a class="hover:text-primary no-underline" href={item.href}>
        {item.data.title}
      </a>
    </h3>
    {deck && <p class="mt-2 max-w-[52ch] text-[0.9375rem] leading-relaxed">{item.data.deck}</p>}
    <p class="text-muted mt-2 font-mono text-[0.6875rem] uppercase">
      By {item.byline}
      {blog.showReadingTime && ` · ${item.minutes} min`}
    </p>
  </div>
</article>
