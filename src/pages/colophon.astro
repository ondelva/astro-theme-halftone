---
// Screen D: the colophon. A masthead, how the magazine works, and where to reach it -- the
// one page here that is all type, which is what keeps it from reading as a fifth desk. The
// standing text is written in this file on purpose: it is yours to rewrite, not a collection.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Author from '../components/common/Author.astro';
import PageHead from '../components/common/PageHead.astro';
import { nav, site } from '../config';
import { formatDate, getArticles, getDesks } from '../lib/content';

const authors = (await getCollection('authors')).sort((a, b) => a.data.order - b.data.order);
// A masthead groups by title and keeps the qualifier beside the name: `Editor, Technology`
// files under Editor and prints `Technology`. An author with no role falls to Contributors.
const masthead = new Map<string, { author: (typeof authors)[number]; qualifier?: string }[]>();
for (const author of authors) {
  const [title, qualifier] = (author.data.role ?? 'Contributors').split(',').map((s) => s.trim());
  masthead.set(title, [...(masthead.get(title) ?? []), { author, qualifier }]);
}

// Contact runs off the editor's own links plus whatever config lists socially, so there is
// no second place to keep an address up to date.
const editor = authors.find((a) => a.data.name === site.author);
const contacts = [...(editor?.data.links ?? []), ...nav.social];

const articles = await getArticles();
const desks = await getDesks();
const since = formatDate(articles[articles.length - 1].data.date);
---

<Base
  title="Colophon"
  description={`Who makes ${site.name}, how it is reported, and where to write to it.`}
>
  <div class="max-w-content mx-auto px-4 pt-10 sm:pt-16">
    <PageHead
      kicker="About"
      title="Colophon"
      lede={`${site.name} is a magazine about how things are actually run: the budget line, the water truck, the piece of software nobody chose. Every piece is reported in the place it happens and photographed there too.`}
      folio={`${articles.length} stories · ${desks.length} desks · published since ${since}`}
    />

    <section class="mt-14 sm:mt-20" aria-labelledby="masthead">
      <h2
        id="masthead"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        Masthead
      </h2>
      <dl>
        {[...masthead].map(([title, members]) => (
          <div class="border-border grid gap-x-8 gap-y-4 border-b py-7 sm:grid-cols-[8rem_1fr]">
            <dt class="font-mono text-xs font-semibold uppercase">{title}</dt>
            <dd class="space-y-6">
              {members.map(({ author, qualifier }) => (
                <Author author={author} role={qualifier} links={false} />
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-14 sm:mt-20" aria-labelledby="how">
      <h2
        id="how"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        How we work
      </h2>
      <div class="article-body mt-7">
        <p>
          A story is assigned when a reporter can get to where it happens and stay long enough to
          watch the thing work or fail. We do not run pieces written off a press release, and we do
          not run pieces without pictures.
        </p>
        <p>
          Figures printed in the rail beside an article carry their source on the line below them.
          Where a figure comes from a body that has an interest in it, the line says so. Where we
          could not confirm a number, it is not in the rail.
        </p>
        <p>
          Corrections are made on the page itself, dated, with the original wording kept in the
          note. A correction that changes what a piece concluded is also printed at the head of the
          desk it was filed to.
        </p>
      </div>
    </section>

    <section class="mt-14 sm:mt-20" aria-labelledby="pictures">
      <h2
        id="pictures"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        Pictures
      </h2>
      <div class="article-body mt-7">
        <p>
          Every photograph on this site is credited beside it. Nothing is staged and nothing is
          composited; adjustments are limited to exposure, contrast and cropping.
        </p>
        <p>
          The pictures in this demo were drawn rather than photographed: generated placeholders
          standing in for the real thing while the theme is being set up.
        </p>
      </div>
    </section>

    <section class="mt-14 sm:mt-20" aria-labelledby="contact">
      <h2
        id="contact"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        Contact
      </h2>
      <div class="article-body mt-7">
        <p>
          Pitches, corrections and rights enquiries go to the editor, {site.author}. Letters about a
          piece should name it.
        </p>
        {/* Set small, so each row is padded out to a thumb-sized target of its own. */}
        <ul class="font-mono text-xs uppercase">
          {contacts.map((link) => (
            <li>
              <a class="inline-block py-1.5" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>
