---
// Dev-only route (injected in astro.config.mjs). Never built for production.
// This is the page to look at in light, dark, and 360px when tokens change.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';

import { coverLines } from '../config';

const colors = [
  '--background',
  '--surface',
  '--foreground',
  '--muted',
  '--border',
  '--primary',
  '--primary-hover',
  '--on-primary',
  '--plate',
  '--on-plate',
  '--on-plate-muted',
  '--primary-on-plate',
];

// Stand-in for the photograph. The plate must hold up on the worst case, so the
// styleguide uses a white field rather than a flattering picture.
const lines = [
  {
    kicker: 'Politics',
    spot: true,
    title: 'A battle for the future',
    deck: 'Three months out, both coalitions are spending more on turnout than on persuasion.',
  },
  {
    kicker: 'Economy',
    spot: false,
    title: 'Markets react to trade policy',
    deck: 'Freight rates out of Rotterdam fell 11% in a week. Nobody at the port expects it to hold.',
  },
  {
    kicker: 'Health',
    spot: false,
    title: 'New hope for patients',
    deck: 'A forty-year-old drug, repurposed, is clearing trials that newer molecules could not.',
  },
].slice(0, coverLines.max);
const sizes = ['text-xs', 'text-sm', 'text-base', 'text-lg', 'text-xl', 'text-2xl', 'text-3xl'];
---

<Base title="Styleguide" noindex>
  <div class="mx-auto max-w-wide space-y-12 px-4 py-12">
    <header class="flex items-baseline justify-between gap-4">
      <h1 class="text-2xl font-bold">Styleguide</h1>
      <ThemeToggle />
    </header>

    <section>
      <h2 class="font-ui text-lg font-semibold">Color</h2>
      <ul class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-3">
        {colors.map((name) => (
          <li class="border-border border p-3">
            <span
              class="block h-10 w-full border border-border"
              style={`background: var(${name})`}
            />
            <code class="font-mono text-xs">{name}</code>
          </li>
        ))}
      </ul>
      <p class="text-muted mt-3 text-sm">
        Contrast is checked by <code class="font-mono">pnpm check:contrast</code>, not by eye.
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Signature — cover lines on a plate</h2>
      <p class="text-muted mt-2 max-w-content text-sm">
        The photograph is replaced by a white field here: the scrim has to hold contrast against the
        worst case, not a flattering picture. Measured floor is 0.73 alpha for
        <code class="font-mono">--on-plate-muted</code>; the plate ships 0.88.
      </p>

      <div class="plate mt-4 min-h-[32rem] p-6 sm:p-10">
        <div class="absolute inset-0 bg-white"></div>
        <p class="font-ui text-spot text-[clamp(3rem,10vw,7rem)] leading-[0.82] font-black tracking-[-0.045em]">
          Halftone
        </p>
        <ol
          class="cover-lines mt-10 max-w-sm"
          data-divider={coverLines.divider}
          style={coverLines.overlay ? undefined : 'background: var(--plate); padding: 1rem'}
        >
          {lines.map((l) => (
            <li class="py-5">
              <span class={l.spot ? 'kicker kicker--spot' : 'kicker'}>{l.kicker}</span>
              <h3 class="font-ui mt-3 mb-2 text-[clamp(1.4rem,3.4vw,2.2rem)] leading-[0.98] font-extrabold tracking-[-0.02em] uppercase">
                {l.title}
              </h3>
              <p
                class="font-ui text-[0.8125rem] leading-relaxed"
                style="color: var(--on-plate-muted)"
              >
                {l.deck}
              </p>
            </li>
          ))}
        </ol>
      </div>
      <p class="text-muted mt-3 font-mono text-xs">
        config.ts — coverLines.overlay={String(coverLines.overlay)}, divider='{coverLines.divider}',
        max={coverLines.max}
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Desk grid</h2>
      <div class="mt-4 flex items-baseline gap-6 border-b-2 border-current pb-2">
        <h3 class="font-ui text-base font-extrabold uppercase">World</h3>
        <span class="text-muted font-mono text-xs">14 stories · September</span>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {[0, 1, 2].map((i) => (
          <article class={i === 0 ? 'lg:col-span-2' : ''}>
            <div class="bg-surface border-border aspect-[3/2] border"></div>
            <span class="kicker mt-3">Diplomacy</span>
            <h4
              class:list={[
                'font-ui mt-2 leading-tight font-bold tracking-tight',
                i === 0 ? 'text-3xl font-extrabold' : 'text-xl',
              ]}
            >
              Global tensions rise amidst economic uncertainty
            </h4>
            <p class="mt-2 max-w-[52ch] text-[0.9375rem] leading-relaxed">
              The agreement took nine days and two walkouts. What it settles is narrower than either
              delegation will admit in public.
            </p>
            <p class="text-muted mt-2 font-mono text-[0.6875rem]">BY MATTHEW SMITH · 9 MIN</p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Type scale</h2>
      <dl class="mt-4 space-y-2">
        {sizes.map((size) => (
          <div class="flex items-baseline gap-4">
            <dt class="font-mono text-muted w-24 shrink-0 text-xs">{size}</dt>
            <dd class={size}>The quick brown fox jumps over the lazy dog</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Body copy</h2>
      <div class="max-w-content mt-4">
        <p>
          Body text runs at the measure set by <code class="font-mono">--content-width</code>. It
          carries <a href="#">an inline link</a>, <em>emphasis</em>,{' '}
          <strong>strong emphasis</strong>, and <code class="font-mono">inline code</code>.
        </p>
      </div>
    </section>
  </div>
</Base>
