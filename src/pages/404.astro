---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { t } from '../i18n';

const ui = t(Astro.currentLocale ?? site.locale);
---

<Base title={ui.notFound} noindex>
  <div class="mx-auto max-w-content px-4 py-24">
    <h1 class="text-3xl font-bold">{ui.notFound}</h1>
    <p class="mt-4 text-muted">{ui.notFoundLine}</p>
    <p class="mt-4">
      <a href="/">{ui.backHome}</a>
    </p>
  </div>
</Base>
