---
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';
import SEO from '../components/common/SEO.astro';
import Analytics from '../components/common/Analytics.astro';
import DemoBar from '../components/common/DemoBar.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import { features, nav, site } from '../config';
import { t } from '../i18n';

// `nameplate` prints the wordmark in the sticky bar. The home page sets it false: there the
// wordmark is the cover, set across the photograph, and a second small one above it reads as
// a repeat rather than a masthead.
type Props = ComponentProps<typeof SEO> & { nameplate?: boolean };
const { nameplate = true, ...seoProps } = Astro.props;
const locale = Astro.currentLocale ?? site.locale;
const ui = t(locale);
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const themeRepo = 'https://github.com/ondelva/astro-theme-halftone';
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* The faces from the fonts block in astro.config.mjs. Preload only what is above the fold
        on the cover: Spectral 400 for decks and body, Schibsted Grotesk 400 for the navigation
        and 800 for the headlines. The 900 wordmark and the mono kickers swap in a frame later,
        which costs nothing here because both sit on the plate at a fixed size. */}
    <Font cssVariable="--font-body" preload={[{ weight: '400', style: 'normal' }]} />
    <Font
      cssVariable="--font-heading"
      preload={[
        { weight: '400', style: 'normal' },
        { weight: '800', style: 'normal' },
      ]}
    />
    <Font cssVariable="--font-mono" />
    <SEO {...seoProps} />
    <Analytics />
    <script is:inline>
      // Before first paint, or the page flashes the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.setAttribute('data-theme', saved);
      } catch {}
    </script>
  </head>
  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-foreground text-background font-ui sr-only z-50 text-sm no-underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only focus:px-4 focus:py-2"
    >
      {ui.skip}
    </a>

    <DemoBar />

    {/* One line, hairline rule under it. The desks are the navigation; there is nothing else
        in it, because everything else about this magazine is on the page below. */}
    <header class="bg-background border-border sticky top-0 z-40 border-b">
      <div class="max-w-wide mx-auto flex flex-wrap items-baseline gap-x-5 gap-y-1 px-4 py-2.5">
        {nameplate && (
          <a
            class="font-ui text-primary shrink-0 text-lg leading-none font-black tracking-[-0.035em] no-underline"
            href="/"
          >
            {site.name}
          </a>
        )}
        <div class="flex w-full flex-wrap items-baseline gap-x-5 gap-y-1 sm:ms-auto sm:w-auto sm:justify-end">
          <nav aria-label={ui.desks} class="font-ui flex items-baseline gap-x-5 gap-y-1 text-sm">
            {nav.header.map((item) => (
              <a
                /* The desk you are on is marked with a rule and the spot colour, not with a
                   heavier weight: a weight change reflows the row, and at 360px this row has
                   nothing to give. style-check-ignore */
                class="hover:text-primary aria-[current=page]:text-primary aria-[current=page]:border-current border-b-2 border-transparent no-underline"
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
          {features.darkMode && <ThemeToggle />}
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>

    <footer class="border-foreground mt-16 border-t-[3px] sm:mt-24">
      <div class="max-w-wide mx-auto flex flex-wrap justify-between gap-x-12 gap-y-8 px-4 py-10 sm:py-14">
        <div class="max-w-[30ch]">
          <p class="font-ui text-primary text-3xl leading-none font-black tracking-[-0.035em]">
            {site.name}
          </p>
          <p class="text-muted mt-3 text-sm">{site.description}</p>
        </div>
        {nav.footer.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="font-mono text-xs font-semibold uppercase">{group.title}</h2>
            <ul class="font-ui text-muted mt-3 space-y-2 text-sm">
              {group.links.map((link) => (
                <li>
                  <a class="hover:text-primary no-underline" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        {nav.social.length > 0 && (
          <ul class="flex items-start gap-4">
            {nav.social.map((link) => (
              <li>
                <a class="hover:text-primary block" href={link.href} aria-label={link.label}>
                  <Icon name={link.icon} class="size-5" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {/* The one line crediting the theme. Deleting it is a line of work and no licence
          trouble; leaving it is how the next person finds the theme. */}
      <p class="max-w-wide text-muted mx-auto px-4 pb-10 font-mono text-[0.6875rem]">
        &copy; {year} {site.name}. Edited by {site.author}.{' '}
        <a class="hover:text-foreground" href={themeRepo}>
          Halftone
        </a>{' '}
        theme by ondelva.
      </p>
    </footer>
  </body>
</html>
